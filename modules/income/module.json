{
  "id": "income",
  "name": "Доход",
  "version": "1.0.0",
  "run": [
    "python3",
    "main.py"
  ],
  "every": "20m",
  "tabs": [
    {
      "id": "income",
      "title": "Доход",
      "blocks": [
        {
          "type": "periods",
          "title": "Доход",
          "icon": "coin",
          "span": 7,
          "src": "income:month",
          "with": {
            "today": "income:today",
            "yesterday": "income:yesterday",
            "year": "income:year",
            "sources": "income:sources"
          }
        },
        {
          "type": "waffle",
          "title": "Продано доступа",
          "icon": "grid",
          "span": 5,
          "src": "income:sold"
        },
        {
          "type": "columns",
          "title": "По месяцам",
          "icon": "chart",
          "span": 12,
          "src": "income:history",
          "with": {
            "now": "income:month",
            "year": "income:year"
          }
        },
        {
          "type": "rows",
          "title": "Покупки",
          "sub": "что купили и где",
          "icon": "bag",
          "span": 5,
          "src": "income:purchases"
        },
        {
          "type": "rate",
          "title": "Реклама по блокам",
          "sub": "доход и выручка на тысячу показов",
          "icon": "ad",
          "span": 7,
          "src": "income:blocks"
        },
        {
          "type": "raster",
          "title": "География рекламы",
          "icon": "chart",
          "span": 7,
          "src": "income:geo"
        },
        {
          "type": "list",
          "title": "Реклама по системам",
          "sub": "где показывали рекламу",
          "icon": "apps",
          "span": 5,
          "src": "income:os"
        },
        {
          "type": "note",
          "title": "Оговорки источников",
          "sub": "почему числа расходятся с кабинетами на несколько процентов",
          "icon": "filter",
          "span": 12,
          "src": "income:notes"
        }
      ]
    }
  ],
  "tiles": [
    {
      "type": "stat",
      "title": "Доход за месяц",
      "src": "income:month"
    },
    {
      "type": "stat",
      "title": "Доход сегодня",
      "src": "income:today"
    }
  ],
  "files": {
    "_комментарий": "Сводки кладёт отдельный сбор по расписанию. Модуль только читает их и превращает в блоки.",
    "summary": "/opt/pocketbase/pb_data/.income.json",
    "history": "/opt/pocketbase/pb_data/.income_history.json",
    "pb_db": "/opt/pocketbase/pb_data/data.db"
  },
  "apps": [
    "app"
  ]
}